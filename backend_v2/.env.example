# Copy to PROJECT ROOT .env. UTF-8 / UTF-8 BOM supported.
# No SET or export. Keep comments on separate lines.
# Replace URL if OpenWebUI is on another server.
OPENWEBUI_URL=http://127.0.0.1:8080
# OpenWebUI ADMIN ACCOUNT API key; not a LiteLLM key, JWT secret or dashboard key.
OPENWEBUI_API_TOKEN=

# Relative paths are resolved from the project root containing .env.
DASHBOARD_CACHE_PATH=data/dashboard-v2.sqlite3
# Leave empty if the organization CSV is not ready.
ORG_USER_CSV_PATH=
# Must be the actual directory containing BUILT index.html and assets.
# User's offline folder is frontend_v2; repo build folder is frontend-v2.
DASHBOARD_FRONTEND_DIR=frontend_v2/dist

OPENWEBUI_PAGE_SIZE=100
OPENWEBUI_TIMEOUT_SECONDS=30
OPENWEBUI_MAX_RETRIES=2
OPENWEBUI_MAX_PAGES_PER_USER=10000
SYNC_OVERLAP_DAYS=7

# Optional authentication for this dashboard API; separate from OpenWebUI key.
DASHBOARD_API_TOKEN=
DASHBOARD_CORS_ORIGINS=

# LiteLLM spend-log collector (separate read-only key; no /v1 suffix).
TOKEN_CACHE_DB_PATH=data/token_usage_v2.sqlite3
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_REQUIRED_API_KEY_ALIAS=
LITELLM_SPEND_LOGS_PATH=/spend/logs/v2
# Per page; values over 100 are capped for older proxies.
LITELLM_LOG_LIMIT=100
LITELLM_SYNC_LOOKBACK_HOURS=24
# REQUIRED before initial/full token sync: first date to collect (YYYY-MM-DD).
LITELLM_SYNC_START_DATE=
# Timezone of naive spend-log timestamps and request date parameters.
LITELLM_LOG_TIMEZONE=UTC
LITELLM_MAX_PAGES_PER_WINDOW=10000
# Optional fallback prices; logged spend, including 0, always takes priority.
MODEL_PRICES_CSV_PATH=

# Question category classifier: separate inference key (NOT spend-log read key).
CATEGORY_CACHE_DB_PATH=data/category_v2.sqlite3
CATEGORY_DEFINITIONS_CSV_PATH=data/question_categories.csv
# Empty URL uses LITELLM_BASE_URL. Both plain base and /v1 are accepted.
CATEGORY_LITELLM_BASE_URL=
CATEGORY_LITELLM_API_KEY=
CATEGORY_LLM_MODEL=
# Internal checkpoint window; full pending run continues until its snapshot is done.
# Use kind=sample or the sample button for a bounded first review.
CATEGORY_LLM_MAX_QUESTIONS=200
CATEGORY_BATCH_SIZE=5
CATEGORY_MAX_QUESTION_CHARS=6000
# Model self-reported score, not a calibrated probability.
CATEGORY_MIN_CONFIDENCE=0.65
# Set false only for models without response_format support; validation stays strict.
CATEGORY_JSON_MODE=true
# Increment to intentionally invalidate classifications without changing the model/CSV.
CATEGORY_CLASSIFIER_REVISION=1
